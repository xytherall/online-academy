NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site URL (no trailing slash), used for canonical links, Open Graph
# URLs and the metadata base. Set to the real Netlify/custom domain in
# production; defaults to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=
# Server-only secret. Never prefix with NEXT_PUBLIC_ or read it from client code.
SUPABASE_SECRET_KEY=
# Server-only secret used to sign the application form's anti-spam token.
# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# /apply fails loudly if this is missing rather than skipping the check.
APPLY_FORM_SECRET=
